# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.dotfiles/zsh/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

#
# Executes commands at the start of an interactive session.
#
# Authors:
#   Sorin Ionescu <sorin.ionescu@gmail.com>
#

# Source Prezto.
if [[ -s "${ZDOTDIR:-$HOME}/.zprezto/init.zsh" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprezto/init.zsh"
fi

# Bring in secrets if they exist
if [[ -s "$HOME/.zsecrets" ]]; then
    source "$HOME/.zsecrets"
fi

# Allow keybindings in menu completion
zstyle ':completion:*' menu select
zmodload zsh/complist

# Bring in keybindings
if [[ -s "${ZDOTDIR:-$HOME}/keys.zsh" ]]; then
    source "${ZDOTDIR:-$HOME}/keys.zsh"
fi

# -- PYENV (static PATH avoids subprocess on every shell start)
export PYENV_ROOT="$HOME/.pyenv"
export PATH="$PYENV_ROOT/shims:$PYENV_ROOT/bin:$PATH"

# -- JENV (lazy-loaded; shims in PATH so java works immediately)
export PATH="$HOME/.jenv/bin:$HOME/.jenv/shims:$PATH"
jenv() {
    unset -f jenv
    eval "$(command jenv init -)"
    jenv "$@"
}

# -- NVM (node bin added directly to PATH for speed; nvm command lazy-loads)
export NVM_DIR="$HOME/.nvm"
export PATH="$NVM_DIR/versions/node/$(< $NVM_DIR/alias/default)/bin:$PATH"
nvm() {
    unset -f nvm
    [ -s "$NVM_DIR/nvm.sh" ] && source "$NVM_DIR/nvm.sh" --no-use
    nvm "$@"
}

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# To customize prompt, run `p10k configure` or edit ~/.dotfiles/zsh/.p10k.zsh.
[[ ! -f ~/.dotfiles/zsh/.p10k.zsh ]] || source ~/.dotfiles/zsh/.p10k.zsh
